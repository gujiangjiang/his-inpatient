# Nginx 配置示例 (生产环境)
# 将 public/ 作为 Web 根目录

server {
    listen 80;
    server_name his.local;
    root /path/to/HIS/public;
    
    index index.html;
    
    # SPA 路由: 非 API 请求返回 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
    
    # API 路由代理到 FrankenPHP Worker
    # 需要配置文件: public/worker.php (FrankenPHP Worker 模式)
    location /api/ {
        # FrankenPHP Worker 模式
        # frankenphp-worker: script='api/worker.php'; env=APP_ENV
        try_files $uri /api/index.php$is_args$args;
    }
    
    # 静态资源缓存
    location ~* \.(js|css|png|jpg|gif|ico|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    
    # 隐藏敏感文件
    location ~ /\.(?!well-known) {
        deny all;
    }
}
